p select-none border-0 outline-none rounded h-control font-sans text-body font-medium [&amp;:disabled:not([aria-busy])]:opacity-50 disabled:pointer-events-none transition-shadow duration-fast focus-visible:shadow-focus text-primary aria-pressed:text-accent aspect-square w-control px-0 !text-muted hover:!text-primary" aria-label="Réessayer"><span aria-hidden="true" class="absolute -z-[1] rounded-[inherit] transition-colors duration-fast group-focus-visible/btn:shadow-[inset_0_0_0_1px_var(--cds-page-bg)] bg-transparent group-hover/btn:bg-fill-ghost-hover group-aria-expanded/btn:bg-fill-ghost-hover inset-0 group-aria-pressed/btn:bg-accent group-hover/btn:group-aria-pressed/btn:bg-accent cds-btn-squish "></span><span class="inline-flex items-center gap-1 "><span data-cds="Icon" aria-hidden="true" style="font-family: var(--font-anthropicons, Anthropicons-Variable); font-feature-settings: &quot;liga&quot; 0; font-optical-sizing: auto; font-style: normal; font-variation-settings: normal; line-height: 1; width: 1em; height: 1em; display: flex; align-items: center; justify-content: center; flex-shrink: 0; user-select: none; font-size: 20px; font-weight: 433.3;"></span></span></button><button type="button" data-cds="Button" class="cds-reset group/btn relative isolate inline-flex shrink-0 items-center justify-center gap-1.5 whitespace-nowrap select-none border-0 outline-none rounded h-control font-sans text-body font-medium [&amp;:disabled:not([aria-busy])]:opacity-50 disabled:pointer-events-none transition-shadow duration-fast focus-visible:shadow-focus text-primary aria-pressed:text-accent aspect-square w-control px-0 !text-muted hover:!text-primary" aria-label="Modifier" data-testid="action-bar-edit"><span aria-hidden="true" class="absolute -z-[1] rounded-[inherit] transition-colors duration-fast group-focus-visible/btn:shadow-[inset_0_0_0_1px_var(--cds-page-bg)] bg-transparent group-hover/btn:bg-fill-ghost-hover group-aria-expanded/btn:bg-fill-ghost-hover inset-0 group-aria-pressed/btn:bg-accent group-hover/btn:group-aria-pressed/btn:bg-accent cds-btn-squish "></span><span class="inline-flex items-center gap-1 "><span data-cds="Icon" aria-hidden="true" style="font-family: var(--font-anthropicons, Anthropicons-Variable); font-feature-settings: &quot;liga&quot; 0; font-optical-sizing: auto; font-style: normal; font-variation-settings: normal; line-height: 1; width: 1em; height: 1em; display: flex; align-items: center; justify-content: center; flex-shrink: 0; user-select: none; font-size: 20px; font-weight: 433.3;"></span></span></button></div><button type="button" data-cds="Button" class="cds-reset group/btn relative isolate inline-flex shrink-0 items-center justify-center gap-1.5 whitespace-nowrap select-none border-0 outline-none rounded h-control font-sans text-body font-medium [&amp;:disabled:not([aria-busy])]:opacity-50 disabled:pointer-events-none transition-shadow duration-fast focus-visible:shadow-focus text-primary aria-pressed:text-accent aspect-square w-control px-0 !text-muted hover:!text-primary" aria-label="Copier" data-testid="action-bar-copy"><span aria-hidden="true" class="absolute -z-[1] rounded-[inherit] transition-colors duration-fast group-focus-visible/btn:shadow-[inset_0_0_0_1px_var(--cds-page-bg)] bg-transparent group-hover/btn:bg-fill-ghost-hover group-aria-expanded/btn:bg-fill-ghost-hover inset-0 group-aria-pressed/btn:bg-accent group-hover/btn:group-aria-pressed/btn:bg-accent cds-btn-squish "></span><span class="inline-flex items-center gap-1 "><span class="relative"><span data-cds="Icon" class="transition-all opacity-100 scale-100" aria-hidden="true" style="font-family: var(--font-anthropicons, Anthropicons-Variable); font-feature-settings: &quot;liga&quot; 0; font-optical-sizing: auto; font-style: normal; font-variation-settings: normal; line-height: 1; width: 1em; height: 1em; display: flex; align-items: center; justify-content: center; flex-shrink: 0; user-select: none; font-size: 20px; font-weight: 433.3;"></span><span data-cds="Icon" class="absolute inset-0 transition-all opacity-0 scale-50" aria-hidden="true" style="font-family: var(--font-anthropicons, Anthropicons-Variable); font-feature-settings: &quot;liga&quot; 0; font-optical-sizing: auto; font-style: normal; font-variation-settings: normal; line-height: 1; width: 1em; height: 1em; display: flex; align-items: center; justify-content: center; flex-shrink: 0; user-select: none; font-size: 20px; font-weight: 433.3;"></span></span></span></button><div class="flex items-center"></div></div></div></div></div></div></div></div></div><div class="[content-visibility:auto] [contain-intrinsic-size:auto_400px] pb-8 -mb-8 print:[content-visibility:visible]"><div data-test-render-count="2"><div class="group" style="height: auto; opacity: 1; transform: none;"><div class="contents"><div data-is-streaming="false" class="group relative relative pb-3" style="opacity: 1; transform: none;"><h2 class="sr-only select-none">Claude a répondu : Le problème est clair — toggleFavVille et toggleFavLieu dans app.</h2><div class="font-claude-response relative leading-[1.65rem] [&amp;_pre&gt;div]:bg-bg-000/50 [&amp;_pre&gt;div]:border-0.5 [&amp;_pre&gt;div]:border-border-400 [&amp;_.ignore-pre-bg&gt;div]:bg-transparent [&amp;_.standard-markdown_:is(p,blockquote,h1,h2,h3,h4,h5,h6)]:pl-2 [&amp;_.standard-markdown_:is(p,blockquote,ul,ol,h1,h2,h3,h4,h5,h6)]:pr-8 [&amp;_.progressive-markdown_:is(p,blockquote,h1,h2,h3,h4,h5,h6)]:pl-2 [&amp;_.progressive-markdown_:is(p,blockquote,ul,ol,h1,h2,h3,h4,h5,h6)]:pr-8"><div><div class="standard-markdown grid-cols-1 grid [&amp;_&gt;_*]:min-w-0 gap-3 standard-markdown"><p class="font-claude-response-body break-words whitespace-normal leading-[1.7]">Le problème est clair — <code class="bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]">toggleFavVille</code> et <code class="bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]">toggleFavLieu</code> dans <code class="bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]">app.js</code> utilisent <code class="bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]">v.id</code> et <code class="bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]">l.id</code> mais les objets dans <code class="bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]">data.js</code> n'ont peut-être pas de champ <code class="bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]">id</code>. Vérifions vite.</p></div></div><div class="mt-4"><div class="grid grid-rows-[auto_auto] min-w-0"><div class="row-start-1 col-start-1 min-w-0"><div class="min-w-0 pl-2 py-1.5"><div class="flex items-center gap-2"><button class="group/status flex items-center gap-2 py-1 text-sm transition-colors cursor-pointer text-left text-text-500 hover:text-text-300 flex-1 min-w-0" aria-expanded="false"><div class="inline-flex items-center gap-1 min-w-0" style="opacity: 1;"><span class="truncate font-base">Exécuté 2 commandes</span><span class="inline-flex transition-transform duration-200 shrink-0 -rotate-90"><div style="width: 12px; height: 12px; display: flex; align-items: center; justify-content: center;"><svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="flex-shrink: 0;"><path d="M14.128 7.165a.502.502 0 0 1 .744.67l-4.5 5-.078.07a.5.5 0 0 1-.666-.07l-4.5-5-.06-.082a.501.501 0 0 1 .729-.656l.075.068L10 11.752z"></path></svg></div></span></div></button></div><span class="sr-only" role="status" aria-live="polite">Exécuté 2 commandes</span><div class="grid transition-[grid-template-rows] duration-300 ease-out" style="grid-template-rows: 0fr;"><div class="overflow-hidden min-w-0"></div></div></div></div><div class="row-start-2 col-start-1 relative grid isolate min-w-0"><div class="row-start-1 col-start-1 relative z-[2] min-w-0"><div><div class="standard-markdown grid-cols-1 grid [&amp;_&gt;_*]:min-w-0 gap-3 standard-markdown"><p class="font-claude-response-body break-words whitespace-normal leading-[1.7]">Les <code class="bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]">id</code> existent bien dans <code class="bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]">data.js</code>. Le problème est ailleurs — dans <code class="bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]">showVille(id)</code> et <code class="bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]">showLieu(id)</code>, le bouton fav appelle <code class="bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]">toggleFav(this)</code> (l'ancienne fonction) au lieu de <code class="bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]">toggleFavVille(v.id)</code>. Le bouton fav n'a jamais été reconnecté au bon id dans cette version.</p></div></div></div></div></div></div><div class="mt-4"><div class="grid grid-rows-[auto_auto] min-w-0"><div class="row-start-1 col-start-1 min-w-0"><div class="min-w-0 pl-2 py-1.5"><div class="flex items-center gap-2"><button class="group/status flex items-center gap-2 py-1 text-sm transition-colors cursor-pointer text-left text-text-500 hover:text-text-300 flex-1 min-w-0" aria-expanded="false"><div class="inline-flex items-center gap-1 min-w-0" style="opacity: 1;"><span class="truncate font-base">A consulté 3 fichiers</span><span class="inline-flex transition-transform duration-200 shrink-0 -rotate-90"><div style="width: 12px; height: 12px; display: flex; align-items: center; justify-content: center;"><svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="flex-shrink: 0;"><path d="M14.128 7.165a.502.502 0 0 1 .744.67l-4.5 5-.078.07a.5.5 0 0 1-.666-.07l-4.5-5-.06-.082a.501.501 0 0 1 .729-.656l.075.068L10 11.752z"></path></svg></div></span></div></button></div><span class="sr-only" role="status" aria-live="polite">A consulté 3 fichiers</span><div class="grid transition-[grid-template-rows] duration-300 ease-out" style="grid-template-rows: 0fr;"><div class="overflow-hidden min-w-0"></div></div></div></div><div class="row-start-2 col-start-1 relative grid isolate min-w-0"><div class="row-start-1 col-start-1 relative z-[2] min-w-0"><div><div class="standard-markdown grid-cols-1 grid [&amp;_&gt;_*]:min-w-0 gap-3 standard-markdown"><p class="font-claude-response-body break-words whitespace-normal leading-[1.7]">Le wiring ville est correct. Vérifions <code class="bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]">showLieu</code> :</p></div></div></div></div></div></div><div class="mt-4"><div class="grid grid-rows-[auto_auto] min-w-0"><div class="row-start-1 col-start-1 min-w-0"><div class="min-w-0 pl-2 py-1.5"><div class="flex items-center gap-2"><button class="group/status flex items-center gap-2 py-1 text-sm transition-colors cursor-pointer text-left text-text-500 hover:text-text-300 flex-1 min-w-0" aria-expanded="false"><div class="inline-flex items-center gap-1 min-w-0" style="opacity: 1;"><span class="truncate font-base">Check showLieu fav wiring</span><span class="inline-flex transition-transform duration-200 shrink-0 -rotate-90"><div style="width: 12px; height: 12px; display: flex; align-items: center; justify-content: center;"><svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="flex-shrink: 0;"><path d="M14.128 7.165a.502.502 0 0 1 .744.67l-4.5 5-.078.07a.5.5 0 0 1-.666-.07l-4.5-5-.06-.082a.501.501 0 0 1 .729-.656l.075.068L10 11.752z"></path></svg></div></span></div></button></div><span class="sr-only" role="status" aria-live="polite">Check showLieu fav wiring</span><div class="grid transition-[grid-template-rows] duration-300 ease-out" style="grid-template-rows: 0fr;"><div class="overflow-hidden min-w-0"></div></div></div></div><div class="row-start-2 col-start-1 relative grid isolate min-w-0"><div class="row-start-1 col-start-1 relative z-[2] min-w-0"><div><div class="standard-markdown grid-cols-1 grid [&amp;_&gt;_*]:min-w-0 gap-3 standard-markdown"><p class="font-claude-response-body break-words whitespace-normal leading-[1.7]">Le code JS est correct. Le vrai problème est dans <code class="bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]">index.html</code> — le bouton fav dans le popup lieu a encore l'ancien <code class="bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]">onclick="toggleFav(this)"</code> au lieu de rien (le onclick est assigné dynamiquement par JS). Vérifions :</p></div></div></div></div></div></div><div class="mt-4"><div class="grid grid-rows-[auto_auto] min-w-0"><div class="row-start-1 col-start-1 min-w-0"><div class="min-w-0 pl-2 py-1.5"><div class="flex items-center gap-2"><button class="group/status flex items-center gap-2 py-1 text-sm transition-colors cursor-pointer text-left text-text-500 hover:text-text-300 flex-1 min-w-0" aria-expanded="false"><div class="inline-flex items-center gap-1 min-w-0" style="opacity: 1;"><span class="truncate font-base">Check fav buttons in HTML</span><span class="inline-flex transition-transform duration-200 shrink-0 -rotate-90"><div style="width: 12px; height: 12px; display: flex; align-items: center; justify-content: center;"><svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="flex-shrink: 0;"><path d="M14.128 7.165a.502.502 0 0 1 .744.67l-4.5 5-.078.07a.5.5 0 0 1-.666-.07l-4.5-5-.06-.082a.501.501 0 0 1 .729-.656l.075.068L10 11.752z"></path></svg></div></span></div></button></div><span class="sr-only" role="status" aria-live="polite">Check fav buttons in HTML</span><div class="grid transition-[grid-template-rows] duration-300 ease-out" style="grid-template-rows: 0fr;"><div class="overflow-hidden min-w-0"></div></div></div></div><div class="row-start-2 col-start-1 relative grid isolate min-w-0"><div class="row-start-1 col-start-1 relative z-[2] min-w-0"><div><div class="standard-markdown grid-cols-1 grid [&amp;_&gt;_*]:min-w-0 gap-3 standard-markdown"><p class="font-claude-response-body break-words whitespace-normal leading-[1.7]">Trouvé ! Lignes 1052-1067 — il y a une <strong>deuxième version</strong> de <code class="bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]">toggleFavVille</code> et <code class="bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]">toggleFavLieu</code> dans <code class="bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]">index.html</code> (l'ancienne version Firebase avec <code class="bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]">async</code>). Elle écrase les fonctions localStorage de <code class="bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]">app.js</code>. Et les boutons HTML ont encore <code class="bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]">onclick="toggleFav(this)"</code> qui ne sauvegarde rien.</p></div></div></div></div></div></div><div class="mt-4"><div class="grid grid-rows-[auto_auto] min-w-0"><div class="row-start-1 col-start-1 min-w-0"><div class="min-w-0 pl-2 py-1.5"><div class="flex items-center gap-2"><button class="group/status flex items-center gap-2 py-1 text-sm transition-colors cursor-pointer text-left text-text-500 hover:text-text-300 flex-1 min-w-0" aria-expanded="false"><div class="inline-flex items-center gap-1 min-w-0" style="opacity: 1;"><span class="truncate font-base">See the old Firebase fav functions in index.html</span><span class="inline-flex transition-transform duration-200 shrink-0 -rotate-90"><div style="width: 12px; height: 12px; display: flex; align-items: center; justify-content: center;"><svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="flex-shrink: 0;"><path d="M14.128 7.165a.502.502 0 0 1 .744.67l-4.5 5-.078.07a.5.5 0 0 1-.666-.07l-4.5-5-.06-.082a.501.501 0 0 1 .729-.656l.075.068L10 11.752z"></path></svg></div></span></div></button></div><span class="sr-only" role="status" aria-live="polite">See the old Firebase fav functions in index.html</span><div class="grid transition-[grid-template-rows] duration-300 ease-out" style="grid-template-rows: 0fr;"><div class="overflow-hidden min-w-0"></div></div></div></div><div class="row-start-2 col-start-1 relative grid isolate min-w-0"><div class="row-start-1 col-start-1 relative z-[2] min-w-0"><div><div class="standard-markdown grid-cols-1 grid [&amp;_&gt;_*]:min-w-0 gap-3 standard-markdown"><p class="font-claude-response-body break-words whitespace-normal leading-[1.7]">Voilà le vrai coupable ! Les anciennes fonctions Firebase dans <code class="bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]">index.html</code> écrasent tout. Je les remplace par les versions localStorage :</p></div></div></div></div></div></div><div class="mt-4"><div class="grid grid-rows-[auto_auto] min-w-0"><div class="row-start-1 col-start-1 min-w-0"><div class="min-w-0 pl-2 py-1.5"><div class="flex items-center gap-2"><button class="group/status flex items-center gap-2 py-1 text-sm transition-colors cursor-pointer text-left text-text-500 hover:text-text-300 flex-1 min-w-0" aria-expanded="false"><div class="inline-flex items-center gap-1 min-w-0" style="opacity: 1;"><span class="truncate font-base">Exécuté 2 commandes, lu un fichier</span><span class="inline-flex transition-transform duration-200 shrink-0 -rotate-90"><div style="width: 12px; height: 12px; display: flex; align-items: center; justify-content: center;"><svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="flex-shrink: 0;"><path d="M14.128 7.165a.502.502 0 0 1 .744.67l-4.5 5-.078.07a.5.5 0 0 1-.666-.07l-4.5-5-.06-.082a.501.501 0 0 1 .729-.656l.075.068L10 11.752z"></path></svg></div></span></div></button></div><span class="sr-only" role="status" aria-live="polite">Exécuté 2 commandes, lu un fichier</span><div class="grid transition-[grid-template-rows] duration-300 ease-out" style="grid-template-rows: 0fr;"><div class="overflow-hidden min-w-0"></div></div></div></div><div class="row-start-2 col-start-1 relative grid isolate min-w-0"><div class="row-start-1 col-start-1 relative z-[2] min-w-0"><div><div class="standard-markdown grid-cols-1 grid [&amp;_&gt;_*]:min-w-0 gap-3 standard-markdown"><p class="font-claude-response-body break-words whitespace-normal leading-[1.7]"><strong>Uniquement <code class="bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]">index.html</code></strong> à remplacer cette fois.</p>
<p class="font-claude-response-body break-words whitespace-normal leading-[1.7]">Le vrai problème : il y avait des <strong>anciennes fonctions Firebase</strong> <code class="bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]">toggleFavVille</code> et <code class="bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]">isFavVille</code> cachées dans <code class="bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]">index.html</code> qui écrasaient les versions localStorage de <code class="bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]">app.js</code>. Elles demandaient même une connexion compte avant de sauvegarder — d'où le comportement sans effet.</p>
<p class="font-claude-response-body break-words whitespace-normal leading-[1.7]">Maintenant les favoris sont 100% localStorage, pas de compte requis, ça marche immédiatement.</p></div></div><div class="flex flex-col gap-2 py-2"><div class="group/artifact-block relative flex text-left font-ui rounded-lg overflow-hidden border-0.5 transition duration-300 w-full hover:bg-bg-000/50 px-4 border-border-300 hover:border-border-200"><button type="button" class="absolute inset-0 cursor-pointer rounded-[inherit] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-accent-200" aria-label="Afficher Index"></button><div class="artifact-block-cell flex flex-1 align-start justify-between w-full"><div class="flex flex-1 gap-2 min-w-0"><div class="flex items-end w-[68px] relative shrink-0 pointer-events-none" aria-hidden="true"><div class="absolute right-2 flex flex-1 overflow-hidden w-[52px] h-[71px] rounded-t-lg border-0.5 border-border-200 select-none scale-[1] group-hover/artifact-block:scale-[1.035] -rotate-[0.1rad] group-hover/artifact-block:-rotate-[0.065rad] duration-300 ease-out group-hover/artifact-block:duration-400 group-hover/artifact-block:ease-[cubic-bezier(0,0.9,0.5,1.35)] transition-transform backface-hidden will-change-transform translate-y-[19%] bg-gradient-to-b from-bg-000 to-bg-000/0 pt-4 items-start justify-center h-full"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 256 256" class="text-text-500"><path d="M67.84,92.61,25.37,128l42.47,35.39a6,6,0,1,1-7.68,9.22l-48-40a6,6,0,0,1,0-9.22l48-40a6,6,0,0,1,7.68,9.22Zm176,30.78-48-40a6,6,0,1,0-7.68,9.22L230.63,128l-42.47,35.39a6,6,0,1,0,7.68,9.22l48-40a6,6,0,0,0,0-9.22Zm-81.79-89A6,6,0,0,0,154.36,38l-64,176A6,6,0,0,0,94,221.64a6.15,6.15,0,0,0,2,.36,6,6,0,0,0,5.64-3.95l64-176A6,6,0,0,0,162.05,34.36Z"></path></svg></div></div><div class="flex flex-col gap-1 py-4 min-w-0 flex-1"><div class="leading-tight text-sm line-clamp-1">Index</d